ARTEMIS_STRATEGIST_BACKSTORY="[REDACTED: PROPRIETARY AGENT SYSTEM INSTRUCTIONS]"
ARTEMIS_WRITER_ROLE="[REDACTED: PROPRIETARY AGENT ROLE DEFINITION]"
